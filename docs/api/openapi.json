                                }
                            }
                        }
                    }
                }
            },
            "put": {
                "tags": [
                    "Prefer\u00c3\u00aancias"
                ],
                "summary": "Salva prefer\u00c3\u00aancias",
                "description": "403 se n\u00c3\u00a3o forem as suas (exceto admin).",
                "operationId": "salvar",
                "parameters": [
                    {
                        "name": "usuarioId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/PreferenciasDto"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/PreferenciasDto"
                                }
                            }
                        }
                    }
                }
            }
        },
