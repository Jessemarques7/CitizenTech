                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/AlertaResponse"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "PreferenciasDto": {
                "type": "object",
                "properties": {
                    "evitarEscadas": {
                        "type": "boolean"
                    },
                    "priorizarRampas": {
                        "type": "boolean"
                    },
                    "alertasVisuais": {
                        "type": "boolean"
                    },
                    "altoContraste": {
                        "type": "boolean"
                    },
                    "usuarioId": {
                        "type": "string"
                    }
                },
                "required": [
                    "alertasVisuais",
                    "altoContraste",
                    "evitarEscadas",
                    "priorizarRampas"
                ]
            },
            "StatusRequest": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            },
            "OcorrenciaResponse": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "localId": {
                        "type": "string"
                    },
                    "localNome": {
                        "type": "string"
                    },
                    "categoria": {
                        "type": "string"
                    },
                    "descricao": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string"
                    },
                    "criadoEm": {
                        "type": "string"
                    },
                    "progresso": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "usuarioId": {
                        "type": "string"
                    },
                    "usuarioNome": {
                        "type": "string"
                    },
                    "dataCriacao": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "dataAtualizacao": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "LocalRequest": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "maxLength": 40,
                        "minLength": 0,
                        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                    },
                    "nome": {
                        "type": "string",
                        "maxLength": 100,
                        "minLength": 0,
                        "pattern": "^[^<>]*$"
                    },
                    "categoria": {
                        "type": "string",
                        "maxLength": 50,
                        "minLength": 0,
                        "pattern": "^[^<>]*$"
                    },
                    "endereco": {
                        "type": "string",
                        "maxLength": 150,
                        "minLength": 0,
                        "pattern": "^[^<>]*$"
                    },
                    "statusAcessibilidade": {
                        "type": "string",
                        "minLength": 1
                    },
                    "resumo": {
                        "type": "string",
                        "maxLength": 400,
                        "minLength": 0,
                        "pattern": "^[^<>]*$"
                    },
                    "confianca": {
                        "type": "string",
                        "maxLength": 60,
                        "minLength": 0,
                        "pattern": "^[^<>]*$"
                    },
                    "recursos": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "maxLength": 150,
                            "minLength": 0,
                            "pattern": "^[^<>]*$"
                        },
                        "maxItems": 20,
                        "minItems": 0
                    },
                    "obstaculos": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "maxLength": 150,
                            "minLength": 0,
                            "pattern": "^[^<>]*$"
                        },
                        "maxItems": 20,
                        "minItems": 0
                    }
                },
                "required": [
                    "obstaculos",
                    "recursos"
                ]
            },
            "LocalResponse": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "nome": {
                        "type": "string"
                    },
                    "categoria": {
                        "type": "string"
                    },
                    "endereco": {
                        "type": "string"
                    },
                    "statusAcessibilidade": {
                        "type": "string"
                    },
                    "resumo": {
                        "type": "string"
                    },
                    "recursos": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "obstaculos": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "ocupacao": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "nivelOcupacao": {
                        "type": "string"
                    },
                    "ultimaLeitura": {
                        "type": "string"
                    },
                    "atualizadoEm": {
                        "type": "string"
                    },
                    "leituraDesatualizada": {
                        "type": "boolean"
                    },
                    "confianca": {
                        "type": "string"
                    }
                }
            },
            "AlertaResponse": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "tipo": {
                        "type": "string"
                    },
