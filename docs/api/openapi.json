        "/api/sensores/leituras": {
            "post": {
                "tags": [
                    "Sensores IoT"
                ],
                "summary": "Registra leituras (dispositivo ou ADMIN)",
                "description": "Aceita um array. Leitura >= limite do sensor gera alerta; abaixo do limite encerra o alerta ativo.",
                "operationId": "registrar",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/components/schemas/LeituraRequest"
                                }
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "201": {
                        "description": "Created",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/LeiturasResponse"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    },
                    {
                        "deviceKey": []
                    }
                ]
            }
        },
        "/api/ocorrencias": {
            "get": {
                "tags": [
                    "Ocorr\u00c3\u00aancias"
                ],
                "summary": "Lista relatos",
                "description": "Cidad\u00c3\u00a3o: s\u00c3\u00b3 os pr\u00c3\u00b3prios (403 se pedir de outro usuarioId). Admin: todos.",
                "operationId": "listar",
                "parameters": [
                    {
                        "name": "usuarioId",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "status",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/OcorrenciaResponse"
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "Ocorr\u00c3\u00aancias"
                ],
                "summary": "Registra barreira",
                "description": "201 com status inicial 'Recebida'; 400 se local/categoria/descri\u00c3\u00a7\u00c3\u00a3o inv\u00c3\u00a1lidos.",
                "operationId": "criar",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/OcorrenciaRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "201": {
                        "description": "Created",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/OcorrenciaResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/locais": {
            "get": {
                "tags": [
                    "Locais"
                ],
                "summary": "Lista locais",
                "description": "Filtros opcionais: status (Acess\u00c3\u00advel, Parcial, Inacess\u00c3\u00advel) e busca por nome/endere\u00c3\u00a7o.",
                "operationId": "listar_1",
                "parameters": [
                    {
                        "name": "status",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "busca",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/LocalResponse"
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "Locais"
                ],
                "summary": "Cadastra local (ADMIN)",
                "description": "201 criado; 400 inv\u00c3\u00a1lido; 403 sem perfil ADMIN; 409 id duplicado.",
                "operationId": "criar_1",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/LocalRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "201": {
                        "description": "Created",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/LocalResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/auth/registrar": {
            "post": {
                "tags": [
                    "Autentica\u00c3\u00a7\u00c3\u00a3o"
                ],
                "summary": "Cria conta de cidad\u00c3\u00a3o",
                "description": "201 com token; 400 dados inv\u00c3\u00a1lidos; 409 e-mail j\u00c3\u00a1 usado.",
                "operationId": "registrar_1",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RegistroRequest"
                            }
                        }
                    },
                    "required": true
